<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sj.mapper.EmpDynamicSqlMapper">
<!--    插入-->
    <insert id="insertEmpBatch">
        insert into t_emp (emp_name,emp_salary,age)
        <foreach collection="emps" item="emp" separator="," open="values">
            (#{emp.empName},#{emp.empSalary},#{emp.age})
        </foreach>
    </insert>

    <select id="selectByEmpNameAndSalary" resultType="com.sj.bean.Emp">
        <!--
            这种写法是有问题的, 因为前端传递过来的是 empName和 empsalary 有可能是 null
            如果是 null 那么语句变成了
            select * from t_emp where empName is null and emp_salary is null;
            此时语义 都发生了变话
            应该是 如果 是null 应该就不查询这个字段了
            解决办法,
                方案1:
                在service层可以进行 非空判断, 只有当 不为空 的时候才放到查询条件中

                方案2: 使用动态sql
            -->
        <!--  select * from t_emp where empName = #{empName} and emp_salary = #{emSalary}-->


        <!--
             这种写法, 如果 emp 是null , empSalary 不是null 此时会多个 and
         -->
        <!--        select * from t_emp where-->
        <!--            <if test="empName != null'">-->
        <!--                empName = #{empName}-->
        <!--            </if>-->
        <!--            <if test="empSalary != null">-->
        <!--                and emp_salary = #{emSalary}-->
        <!--            </if>-->


        <!--
            使用 where 标签 可以解决 上面的问题, where 会自动把第一个条件前面的 and 或者 or 去掉
            where标签 可以解决 where 后面 的语法错误
        -->
        select * from t_emp
        <where>
            <if test="empName != null">
                emp_name = #{empName}
            </if>
            <if test="empSalary != null">
                and emp_salary = #{empSalary}
            </if>
        </where>

    </select>


    <update id="updateEmp">
        update t_emp
        <set>
            <!--   这里使用了 @Param("emp") 因此取值的时候,使用 emp.xxx的方式         -->
            <if test="emp.empName != null">
                emp_name = #{empName},
            </if>
            <if test="emp.empSalary != null">
                and emp_salary = #{empSalary}
            </if>
            <if test="emp.age != null">
                and age = #{age}
            </if>
        </set>
        empId = #{empId}
    </update>

<!--
批量更新
需要mysql层面支持,批量更新
spring.datasource.url=jdbc:mysql://localhost:3306/mybatis-example?allowMultiQueries=true

-->
    <update id="updateEmpBatch">
        <foreach collection="emps" item="emp" separator=";">
            UPDATE t_emp
            <set>
                <if test="emp.empName != null">
                    emp_name = #{emp.empName},
                </if>
                <if test="emp.empSalary != null">
                    emp_salary = #{emp.empSalary},
                </if>
                <if test="emp.age != null">
                    age = #{emp.age},
                </if>
            </set>
            WHERE emp_id = #{emp.empId}
        </foreach>
    </update>

    <!--
        trim 标签实现实现
        prefix: 前缀   如果有内容, 则会拼一个前缀
        suffix: 后缀   如果有内容, 则会拼一个后缀,
        suffixOverrides: 后缀覆盖   如果有内容, 则会覆盖后缀,
        prefixOverrides: 前缀覆盖   如果有内容, 则会覆盖前缀
        trim 标签可以 实现 where 1=1 的效果
        prefixOverrides="and || or" 如果有前缀有 and 或 or 会被覆盖成 ""
    -->
    <select id="selectByEmpNameAndSalaryByTrimLable" resultType="com.sj.bean.Emp">
        select * from t_emp
        <trim prefix="where" prefixOverrides="and || or">
            <if test="empName != null">
                emp_name = #{empName}
            </if>
            <if test="emSalary != null">
                and emp_salary = #{emSalary}
            </if>
        </trim>
    </select>

    <!--

    separator 以什么分割
    open 前缀
    close 后缀
    foreach 标签 做批量插入

    -->
    <select id="selectEmpByIdsIn" resultType="com.sj.bean.Emp">
        <!--        select * from t_emp where id in = {#{ids[0],#ids[1],......}-->

        select * from t_emp
        <foreach collection="ids" item="id" separator="," open="where id in (" close=")">
            #{id}
        </foreach>
    </select>

</mapper>