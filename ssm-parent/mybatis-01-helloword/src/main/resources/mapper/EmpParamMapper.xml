<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sj.mapper.EmpParamMapper">
    <insert id="insertEmp">
        insert into t_emp(emp_name,age) values (#{emp.empName}, #{emp.age})
    </insert>
    <select id="selectEmpById" resultType="com.sj.bean.Emp">
        select * from t_emp where id = #{id}
    </select>
    <select id="selectEmpByIds" resultType="com.sj.bean.Emp">
        select * from t_emp where id = #{ids[1]}
    </select>
    <select id="aaaEmploy">

    </select>
</mapper>