<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sj.mapper.EmpReturnValueMapper">
    <insert id="insertEmp">
        insert into t_emp(emp_name, age) values (#{emp.empName}, #{emp.age})
    </insert>
    <insert id="insertEmpReturnId" useGeneratedKeys="true" keyProperty="id">
        insert into t_emp(emp_name, age) values (#{emp.empName}, #{emp.age})
    </insert>

    <select id="countEmp" resultType="java.lang.Integer">
        select count(*) from t_emp
    </select>

<!--
    这个方法的返回是是一个 map , map 是key value 形式的, 这里的返回值类型 指的是value的类型

    简单理解: 返回 Map 也是集合, 只要是集合,就要写里面元素的类型

 -->
    <select id="selectMapAll" resultType="com.sj.bean.Emp">
        select * from t_emp;
    </select>
</mapper>